    bool Init(API api, WindowedMode windowMode) {
        g_api = api;

        // Avoid startup issues with RenderDoc probing during bring-up
        //CheckForRenderDoc();
        g_renderDocFound = true;

        // Engine config
        Config::Init();

        // Create window and (for OpenGL) make context current inside Integration::GLFW
        if (!GLFW::Init(api, windowMode)) {
            Logging::Error() << "GLFW::Init() failed";
            return false;
        }

        // API backends (OpenGL-first)
        if (GetAPI() == API::OPENGL) {
            // Must be called after GLFW::Init so a current context exists
            OpenGLBackEnd::Init();
            OpenGLRenderer::Init();
            Logging::Init() << "OpenGL initialized";
        }
        else if (GetAPI() == API::VULKAN) {
            if (!VulkanBackEnd::Init()) {
                Logging::Error() << "VulkanBackEnd::Init() failed";
                return false;
            }
            Logging::Init() << "Vulkan initialized";
        }

        // Assets/UI/Input and editor subsystems
        AssetManager::Init();
        Logging::Init() << "AssetManager::Init()";

        UIBackEnd::Init();
        Logging::Init() << "UIBackEnd::Init()";


        Input::Init(BackEnd::GetWindowPointer());
        Logging::Init() << "Input::Init()";



        Gizmo::Init();
        Logging::Init() << "Gizmo::Init()";

        ViewportManager::Init();
        Logging::Init() << "ViewportManager::Init()";

        Editor::Init();
        Logging::Init() << "Editor::Init()";

        ImGuiBackEnd::Init();
        Logging::Init() << "ImGuiBackEnd::Init()";


        glfwShowWindow(static_cast<GLFWwindow*>(BackEnd::GetWindowPointer()));
        return true;
    }

