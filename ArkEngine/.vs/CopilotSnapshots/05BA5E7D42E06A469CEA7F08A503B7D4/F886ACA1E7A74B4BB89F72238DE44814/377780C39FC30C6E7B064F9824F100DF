#include "BackEnd/BackEnd.h"
#include <iostream>

int main() {
    std::cout << "Initializing ArkEngine minimal window...\n";
    if (!BackEnd::Init(API::OPENGL, WindowedMode::WINDOWED)) {
        std::cout << "Backend init failed\n";
        return -1;
    }

    while (BackEnd::WindowIsOpen()) {
        BackEnd::BeginFrame();
        // No rendering; empty window
        BackEnd::EndFrame();
    }

    BackEnd::CleanUp();
    return 0;
}